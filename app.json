{
  "expo": {
    "name": "PropEase",
    "slug": "propease",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.propease.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Used to pick emergency contact",
        "NSPhotoLibraryUsageDescription": "Used to save receipts"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.propease.app",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-font"
    ],
    "owner": "sriniexpo09",
    "extra": {
      "eas": {
        "projectId": "ccf1467d-203b-4097-9d9c-1c52ca0134ff"
      }
    }
  }
}
