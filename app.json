{
  "expo": {
    "name": "RentEase",
    "slug": "rentease",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rentease.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Used to pick emergency contact",
        "NSPhotoLibraryUsageDescription": "Used to save receipts"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.rentease.app",
      "permissions": [],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "abiFilters": [
        "arm64-v8a"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "owner": "sriniexpo09",
    "extra": {
      "eas": {
        "projectId": "993c3327-cf22-4baa-a118-41b79e18aa1c"
      }
    }
  }
}
