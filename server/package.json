{
  "name": "panic-alarm-server",
  "version": "1.0.0",
  "description": "Panic Alarm Server — Hospital Emergency Notification System",
  "main": "server-main.js",
  "scripts": {
    "start": "node server.js",
    "start-desktop": "electron .",
    "build-win": "node obfuscate-build.js electron-builder --win --x64",
    "build-win-plain": "electron-builder --win --x64",
    "build-mac": "node obfuscate-build.js electron-builder --mac --arm64 && bash fix-mac-dmg.sh",
    "build-mac-plain": "electron-builder --mac --arm64 && bash fix-mac-dmg.sh",
    "build-linux": "electron-builder --linux"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "26.15.3",
    "javascript-obfuscator": "^5.10.1"
  },
  "build": {
    "afterPack": "./afterPack.js",
    "extraResources": [
      {
        "from": "watchdog.vbs",
        "to": "watchdog.vbs"
      }
    ],
    "appId": "com.hospital.panicalarm.server",
    "productName": "PanicAlarmServer",
    "copyright": "Hospital Panic Alarm System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server-main.js",
      "server-preload.js",
      "server.js",
      "db.js",
      "db-migrate.js",
      "auth.js",
      "event-log.js",
      "license.js",
      "license-codec.js",
      "license-keys.js",
      "alarm-logs.js",
      "mailer.js",
      "package.json",
      "renderer/**/*",
      "public/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/better-sqlite3/{deps,src}/**",
      "!node_modules/better-sqlite3/build/Release/{obj,.deps}/**",
      "!node_modules/better-sqlite3/build/Release/test_extension.node",
      "!node_modules/**/*.{md,markdown,map,ts}",
      "!node_modules/**/{test,tests,docs,example,examples}/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/server-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "installer.nsh",
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Panic Alarm Server",
      "installerIcon": "assets/server-icon.ico",
      "uninstallerIcon": "assets/server-icon.ico",
      "runAfterFinish": true
    },
    "dmg": {
      "internetEnabled": false,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 185,
          "type": "file"
        },
        {
          "x": 390,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/server-icon.icns",
      "category": "public.app-category.healthcare-fitness",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": false,
        "LSBackgroundOnly": false
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/server-icon.png"
    }
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  }
}
