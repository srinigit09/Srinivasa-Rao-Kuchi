# ==============================================================================
# Panic Alarm Server — First-Run Seeding Properties (bootstrap.env)
# 
# These values are only read ONCE when the application starts for the first time
# to initialize the SQLite database and seed the default administrator account.
# After first-run setup, changing this file will have NO effect.
# ==============================================================================

# Default Admin Credentials (seeding only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@PanicAlarm2026

# Static JWT cryptographic secret used to sign admin and client session tokens.
# - If left commented out, the server automatically generates a secure, random
#   secret on first run and stores it in the database.
# - Only uncomment and set this if you are running a multi-server cluster or 
#   require sessions to survive direct database deletions.
# JWT_SECRET=
