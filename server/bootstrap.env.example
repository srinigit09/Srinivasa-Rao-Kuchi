# ==============================================================================
# Panic Alarm Server — First-Run Seeding Properties (bootstrap.env)
#
# These values are only read ONCE when the application starts for the first time
# to initialise the SQLite database and seed the default administrator account.
# After first-run setup, changing this file will have NO effect.
#
# To apply: rename this file to "bootstrap.env" and place it next to the
# installed application executable before first launch.
# ==============================================================================

# Default Admin Credentials (used for seeding only — change after first login)
# ADMIN_USERNAME=<choose-a-username>
# ADMIN_PASSWORD=<choose-a-strong-password>

# Static JWT cryptographic secret used to sign admin and client session tokens.
# - If left commented out, the server automatically generates a secure, random
#   secret on first run and stores it in the database.
# - Only set this if you are running a multi-server cluster or require sessions
#   to survive direct database deletions. Use at least 32 random characters.
# JWT_SECRET=<at-least-32-random-characters>
