# Server configuration
PORT=4000
HOST=0.0.0.0

# JWT Secret — optional. If unset (or left as a CHANGE_ME value) the server generates a random
# secret on first run and stores it in its database. Set it only to share one secret across restarts
# of a server run from source; use at least 32 random characters.
# JWT_SECRET=

# Admin credentials (used only for first-run seed; change after seeding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@PanicAlarm2026

# Database path (relative to server directory)
DB_PATH=./data/panic_alarm.db
