# Server configuration (development use — rename to .env)
# PORT=<port-number>
# HOST=<ip-or-0.0.0.0>

# JWT Secret — optional. If unset, the server generates a random secret on
# first run and stores it in the database. Set it only to share one secret
# across restarts when running from source. Use at least 32 random characters.
# JWT_SECRET=<at-least-32-random-characters>

# Admin credentials (used only for first-run seed — change after seeding)
# ADMIN_USERNAME=<choose-a-username>
# ADMIN_PASSWORD=<choose-a-strong-password>

# Database path (relative to server directory)
# DB_PATH=<path-to-database-file>
