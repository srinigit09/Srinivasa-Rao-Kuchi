{
  "name": "panic-alarm-client",
  "version": "1.0.0",
  "description": "Panic Alarm Client - Zero-login desktop app for hospital rooms",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "node obfuscate-build.js electron-builder --win --x64",
    "build-win-plain": "electron-builder --win --x64",
    "build-mac": "node obfuscate-build.js electron-builder --mac --arm64 && bash fix-mac-dmg.sh",
    "build-mac-plain": "electron-builder --mac --arm64 && bash fix-mac-dmg.sh",
    "build-linux": "electron-builder --linux"
  },
  "dependencies": {
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "26.15.3",
    "javascript-obfuscator": "^5.10.1"
  },
  "build": {
    "afterPack": "./afterPack.js",
    "extraResources": [
      {
        "from": "watchdog.vbs",
        "to": "watchdog.vbs"
      }
    ],
    "appId": "com.hospital.panicalarmclient",
    "productName": "PanicAlarmClient",
    "copyright": "Hospital Panic Alarm System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.{md,markdown,map,ts}",
      "!node_modules/**/{test,tests,docs,example,examples}/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "installer.nsh",
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Panic Alarm Client",
      "runAfterFinish": true
    },
    "dmg": {
      "internetEnabled": false,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 185,
          "type": "file"
        },
        {
          "x": 390,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.healthcare-fitness",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": false,
        "LSBackgroundOnly": false
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "license": "UNLICENSED",
  "private": true
}
